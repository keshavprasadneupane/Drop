# ==============================================================================
# 🎯 Project Settings
# ==============================================================================
PROJECT_NAME="Bagg"
PROJECT_VERSION="1.0.0"
DEBUG=False

# ==============================================================================
# 🐘 Database Configuration
# ==============================================================================
# NOTE: POSTGRES_* variables are consumed directly by compose.yaml to 
# initialize and configure the secure PostgreSQL container instance.
POSTGRES_USER=your_postgres_user
POSTGRES_PASSWORD=your_secure_postgres_password
POSTGRES_DB=your_database_name

# NOTE: POSTGRES_HOST MUST match the database service name defined under 
# 'services:' in compose.yaml (e.g., 'db'). Docker's internal DNS uses this
# service name to route network traffic between containers.
# (For running local scripts outside Docker, change this to 'localhost')
POSTGRES_HOST=db
POSTGRES_PORT=5432

# NOTE: DATABASE_URL uses variable expansion for Docker Compose. 
# If loading directly into Pydantic BaseSettings without Docker, construct this
# string dynamically inside settings.py (@computed_field) to avoid unexpanded variables.
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# ==============================================================================
# 🔒 Security & Authentication
# ==============================================================================
# Run 'openssl rand -hex 32' in your terminal to generate secure, production keys
SECRET_KEY=change_me_generate_with_openssl_rand_hex_32
REFRESH_SECRET_KEY=change_me_generate_with_openssl_rand_hex_32
ALGORITHM=HS256

# JWT Expiration Windows
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7